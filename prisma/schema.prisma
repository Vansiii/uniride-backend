// Esquema de UniRide (SPECS/ssd.md §6). Los modelos llegan con cada HU (primero HU-06).
// Convención: model en PascalCase singular + @@map a la tabla snake_case plural.
// Las políticas RLS van en SQL dentro de las migraciones (Prisma no las modela).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- HU-06: cuentas, sesiones y auditoría ---

/// Dato personal (D-07): sin organizacion_id, se protege por dueño.
model Usuario {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  correo                String
  hashContrasena        String    @map("hash_contrasena")
  nombreCompleto        String    @map("nombre_completo")
  rolPlataforma         String?   @map("rol_plataforma")
  estadoIdentidad       String    @default("no_verificada") @map("estado_identidad")
  intentosFallidos      Int       @default(0) @map("intentos_fallidos")
  bloqueadoHasta        DateTime? @map("bloqueado_hasta") @db.Timestamptz(3)
  ultimaOrganizacionId  String?   @map("ultima_organizacion_id") @db.Uuid
  consentimientoDatosEn DateTime? @map("consentimiento_datos_en") @db.Timestamptz(3)
  suspendidaEn          DateTime? @map("suspendida_en") @db.Timestamptz(3)
  creadoEn              DateTime  @default(now()) @map("creado_en") @db.Timestamptz(3)

  tokensRefresco TokenRefresco[]
  membresias     Membresia[]
  vehiculo       Vehiculo?
  identidad      Identidad?
  dispositivos   Dispositivo[]
  billetera      Billetera?
  ordenesRecarga OrdenRecarga[]
  viajes         Viaje[]
  reservas       Reserva[]

  @@map("usuarios")
}

model TokenRefresco {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId     String    @map("usuario_id") @db.Uuid
  hashToken     String    @unique @map("hash_token")
  tipoCliente   String    @map("tipo_cliente")
  venceEn       DateTime  @map("vence_en") @db.Timestamptz(3)
  sesionVenceEn DateTime  @map("sesion_vence_en") @db.Timestamptz(3)
  revocadoEn    DateTime? @map("revocado_en") @db.Timestamptz(3)
  creadoEn      DateTime  @default(now()) @map("creado_en") @db.Timestamptz(3)

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId])
  @@map("tokens_refresco")
}

/// Solo inserción. `organizacion_id` sin FK: la auditoría también guarda eventos sin organización.
model RegistroAuditoria {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizacionId String?  @map("organizacion_id") @db.Uuid
  actorId        String?  @map("actor_id") @db.Uuid
  accion         String
  entidad        String
  entidadId      String?  @map("entidad_id")
  resultado      String
  detalle        Json?
  creadoEn       DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)

  @@index([organizacionId])
  @@map("registros_auditoria")
}

// --- HU-01: organizaciones, membresías, invitaciones y cola de correos ---

model Organizacion {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre            String
  nombreNormalizado String   @unique @map("nombre_normalizado")
  tipo              String
  modoAprobacion    String   @default("manual") @map("modo_aprobacion")
  precioMaximoUrc   Decimal  @map("precio_maximo_urc") @db.Decimal(12, 2)
  estado            String   @default("activa")
  creadoEn          DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)

  membresias   Membresia[]
  invitaciones Invitacion[]
  dominios     DominioOrganizacion[]
  viajes       Viaje[]
  reservas     Reserva[]

  @@map("organizaciones")
}

// --- HU-02: reglas de afiliación ---

/// Dominio en minúsculas y sin `@`; UNIQUE en toda la plataforma (RN-2).
model DominioOrganizacion {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizacionId String   @map("organizacion_id") @db.Uuid
  dominio        String   @unique
  creadoEn       DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)

  organizacion Organizacion @relation(fields: [organizacionId], references: [id])

  @@index([organizacionId])
  @@map("dominios_organizacion")
}

model Membresia {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizacionId      String    @map("organizacion_id") @db.Uuid
  usuarioId           String    @map("usuario_id") @db.Uuid
  rol                 String
  estado              String
  correoInstitucional String?   @map("correo_institucional")
  decididoPor         String?   @map("decidido_por") @db.Uuid
  decididoEn          DateTime? @map("decidido_en") @db.Timestamptz(3)
  motivo              String?
  creadoEn            DateTime  @default(now()) @map("creado_en") @db.Timestamptz(3)

  organizacion Organizacion @relation(fields: [organizacionId], references: [id])
  usuario      Usuario      @relation(fields: [usuarioId], references: [id])

  @@unique([organizacionId, usuarioId])
  @@map("membresias")
}

model Invitacion {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizacionId String    @map("organizacion_id") @db.Uuid
  correo         String
  nombre         String
  hashToken      String    @unique @map("hash_token")
  venceEn        DateTime  @map("vence_en") @db.Timestamptz(3)
  usadaEn        DateTime? @map("usada_en") @db.Timestamptz(3)
  reemplazadaEn  DateTime? @map("reemplazada_en") @db.Timestamptz(3)
  creadoPor      String    @map("creado_por") @db.Uuid
  creadoEn       DateTime  @default(now()) @map("creado_en") @db.Timestamptz(3)

  organizacion Organizacion @relation(fields: [organizacionId], references: [id])

  @@index([organizacionId])
  @@map("invitaciones")
}

// --- HU-05: códigos OTP ---

/// Dato personal (D-07): sin organizacion_id ni RLS. Correo en minúsculas; el código solo como HMAC.
model CodigoOtp {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  correo         String
  proposito      String
  hashCodigo     String    @map("hash_codigo")
  datos          Json
  venceEn        DateTime  @map("vence_en") @db.Timestamptz(3)
  intentos       Int       @default(0)
  bloqueadoHasta DateTime? @map("bloqueado_hasta") @db.Timestamptz(3)
  usadoEn        DateTime? @map("usado_en") @db.Timestamptz(3)
  invalidadoEn   DateTime? @map("invalidado_en") @db.Timestamptz(3)
  creadoEn       DateTime  @default(now()) @map("creado_en") @db.Timestamptz(3)

  @@index([correo, proposito, creadoEn])
  @@map("codigos_otp")
}

// --- HU-11: vehículos ---

/// Dato personal (D-07): sin organizacion_id ni RLS, se protege por dueño. `claveS3Foto` nunca sale de la API (D-20).
model Vehiculo {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  propietarioId        String   @unique @map("propietario_id") @db.Uuid
  placa                String   @unique
  marca                String
  modelo               String
  color                String
  capacidad            Int
  claveS3Foto          String   @map("clave_s3_foto")
  consentimientoFotoEn DateTime @map("consentimiento_foto_en") @db.Timestamptz(3)
  creadoEn             DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)

  propietario Usuario @relation(fields: [propietarioId], references: [id])
  viajes      Viaje[]

  @@map("vehiculos")
}

// --- HU-17: publicar viaje ---

/// Máquina de estados del viaje (`AGENTS.md` §5.9): el servidor controla las transiciones.
enum EstadoViaje {
  publicado
  reservado
  en_curso
  verificado
  pagado
  cancelado
  expirado

  @@map("estado_viaje")
}

/// Dato institucional con RLS (A-13). Los CHECK de cupos, precio y coordenadas están en la migración.
model Viaje {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizacionId   String      @map("organizacion_id") @db.Uuid
  conductorId      String      @map("conductor_id") @db.Uuid
  vehiculoId       String      @map("vehiculo_id") @db.Uuid
  origenNombre     String      @map("origen_nombre")
  origenLat        Decimal     @map("origen_lat") @db.Decimal(9, 6)
  origenLng        Decimal     @map("origen_lng") @db.Decimal(9, 6)
  destinoNombre    String      @map("destino_nombre")
  destinoLat       Decimal     @map("destino_lat") @db.Decimal(9, 6)
  destinoLng       Decimal     @map("destino_lng") @db.Decimal(9, 6)
  fechaHoraSalida  DateTime    @map("fecha_hora_salida") @db.Timestamptz(3)
  cuposTotales     Int         @map("cupos_totales")
  cuposDisponibles Int         @map("cupos_disponibles")
  precioPorAsiento Decimal     @map("precio_por_asiento") @db.Decimal(12, 2)
  estado           EstadoViaje @default(publicado)
  creadoEn         DateTime    @default(now()) @map("creado_en") @db.Timestamptz(3)

  organizacion Organizacion @relation(fields: [organizacionId], references: [id])
  conductor    Usuario      @relation(fields: [conductorId], references: [id])
  vehiculo     Vehiculo     @relation(fields: [vehiculoId], references: [id])
  reservas     Reserva[]

  @@index([organizacionId, estado, fechaHoraSalida, cuposDisponibles], map: "idx_viajes_busqueda")
  @@index([conductorId, fechaHoraSalida])
  @@map("viajes")
}

// --- HU-08: verificación de identidad ---

/// Dato personal (D-07): sin organizacion_id ni RLS, se protege por dueño. Fuente de verdad del estado de identidad
/// (la columna `usuarios.estado_identidad` no se usa). `documentoHash`, `claveS3Carnet` y `faceIdColeccion` nunca salen de la API.
/// Se crea en el primer intento y solo se llenan hash, clave y face id al quedar verificada (así un intento fallido no reserva un documento ajeno).
model Identidad {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId        String    @unique @map("usuario_id") @db.Uuid
  documentoHash    String?   @unique @map("documento_hash")
  estado           String    @default("no_verificada")
  similitudFacial  Decimal?  @map("similitud_facial") @db.Decimal(5, 2)
  claveS3Carnet    String?   @map("clave_s3_carnet")
  faceIdColeccion  String?   @map("face_id_coleccion")
  intentosFallidos Int       @default(0) @map("intentos_fallidos")
  bloqueadoHasta   DateTime? @map("bloqueado_hasta") @db.Timestamptz(3)
  consentimientoEn DateTime  @map("consentimiento_en") @db.Timestamptz(3)
  verificadoEn     DateTime? @map("verificado_en") @db.Timestamptz(3)
  creadoEn         DateTime  @default(now()) @map("creado_en") @db.Timestamptz(3)

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@map("identidades")
}

// --- HU-09: vinculación de dispositivo ---

/// Dato personal (D-07): sin organizacion_id ni RLS, se protege por dueño. Un dispositivo por cuenta en v1 (A-02).
/// Solo se guarda la llave pública; la privada nunca sale del Keystore del teléfono.
/// En HU-10 pasa a 1–N para conservar el historial de teléfonos inactivos (RN-6).
model Dispositivo {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId           String    @map("usuario_id") @db.Uuid
  llavePublica        String    @map("llave_publica")
  algoritmo           String    @default("ECDSA_P256")
  modeloDispositivo   String    @map("modelo_dispositivo")
  veredictoIntegridad String    @map("veredicto_integridad")
  activo              Boolean   @default(true)
  vinculadoEn         DateTime  @default(now()) @map("vinculado_en") @db.Timestamptz(3)
  desactivadoEn       DateTime? @map("desactivado_en") @db.Timestamptz(3)
  ultimoUsoEn         DateTime? @map("ultimo_uso_en") @db.Timestamptz(3)

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId])
  @@map("dispositivos")
}

// --- HU-12: billetera ---

/// Dato personal (D-07): sin organizacion_id ni RLS, se protege por dueño. Una billetera por usuario (A-02).
/// `llaveCustodiaRef` guarda la llave privada solo cifrada (A-12) y nunca sale en respuestas, logs ni auditoría.
model Billetera {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId        String   @unique @map("usuario_id") @db.Uuid
  direccion        String   @unique
  llaveCustodiaRef String   @map("llave_custodia_ref")
  creadoEn         DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn    DateTime @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  usuario     Usuario               @relation(fields: [usuarioId], references: [id])
  movimientos MovimientoBilletera[]
  ordenes     OrdenRecarga[]

  @@map("billeteras")
}

/// Libro mayor (HU-14): solo inserción; de una fila ya escrita solo cambian `estado` y `hashTx`, y una vez confirmada ya no (trigger y GRANT en la migración).
model MovimientoBilletera {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  billeteraId       String   @map("billetera_id") @db.Uuid
  tipo              String
  monto             Decimal  @db.Decimal(12, 2)
  estado            String   @default("pendiente")
  reservaId         String?  @map("reserva_id") @db.Uuid
  hashTx            String?  @map("hash_tx")
  claveIdempotencia String   @unique @map("clave_idempotencia")
  metadatos         Json?
  creadoEn          DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)

  billetera Billetera       @relation(fields: [billeteraId], references: [id])
  reserva   Reserva?        @relation(fields: [reservaId], references: [id], onDelete: Restrict)
  trabajo   TrabajoOnchain?

  @@index([billeteraId, creadoEn(sort: Desc)])
  @@index([reservaId])
  @@map("movimientos_billetera")
}

/// HU-13: dato personal, se protege por dueño. Su movimiento lleva la clave `recarga:<id>`.
model OrdenRecarga {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId    String    @map("usuario_id") @db.Uuid
  billeteraId  String    @map("billetera_id") @db.Uuid
  monto        Decimal   @db.Decimal(12, 2)
  estado       String    @default("pendiente")
  hashTx       String?   @map("hash_tx")
  expiraEn     DateTime  @map("expira_en") @db.Timestamptz(3)
  completadaEn DateTime? @map("completada_en") @db.Timestamptz(3)
  creadoEn     DateTime  @default(now()) @map("creado_en") @db.Timestamptz(3)

  usuario   Usuario   @relation(fields: [usuarioId], references: [id])
  billetera Billetera @relation(fields: [billeteraId], references: [id])

  @@index([usuarioId, expiraEn])
  @@map("ordenes_recarga")
}

/// Cola on-chain (D-10): tabla interna, sin acceso de usuarios.
model TrabajoOnchain {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  movimientoId     String   @unique @map("movimiento_id") @db.Uuid
  operacion        String
  intentos         Int      @default(0)
  proximoIntentoEn DateTime @default(now()) @map("proximo_intento_en") @db.Timestamptz(3)
  ultimoError      String?  @map("ultimo_error")
  estado           String   @default("pendiente")
  creadoEn         DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)

  movimiento MovimientoBilletera @relation(fields: [movimientoId], references: [id])

  @@index([estado, proximoIntentoEn])
  @@map("trabajos_onchain")
}

/// Tabla interna del worker de correos: sin organización ni RLS.
model CorreoSaliente {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  destinatario     String
  plantilla        String
  datos            Json
  estado           String   @default("pendiente")
  intentos         Int      @default(0)
  proximoIntentoEn DateTime @default(now()) @map("proximo_intento_en") @db.Timestamptz(3)
  ultimoError      String?  @map("ultimo_error")
  referenciaTipo   String?  @map("referencia_tipo")
  referenciaId     String?  @map("referencia_id") @db.Uuid
  creadoEn         DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)

  @@index([estado, proximoIntentoEn])
  @@index([referenciaTipo, referenciaId])
  @@map("correos_salientes")
}

// --- HU-19: reserva con escrow ---

/// Dato institucional: lleva `organizacion_id` y RLS (A-13). El monto lo fija el servidor con el precio del viaje.
/// Estados (D-23): pendiente → confirmada → abordada → verificada → pagada; además fallida y verificacion_fallida.
model Reserva {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizacionId    String   @map("organizacion_id") @db.Uuid
  viajeId           String   @map("viaje_id") @db.Uuid
  pasajeroId        String   @map("pasajero_id") @db.Uuid
  monto             Decimal  @db.Decimal(12, 2)
  estado            String   @default("pendiente")
  claveIdempotencia String   @unique @map("clave_idempotencia")
  motivo            String?
  creadoEn          DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn     DateTime @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  organizacion Organizacion          @relation(fields: [organizacionId], references: [id])
  viaje        Viaje                 @relation(fields: [viajeId], references: [id])
  pasajero     Usuario               @relation(fields: [pasajeroId], references: [id])
  movimientos  MovimientoBilletera[]

  @@index([viajeId, estado])
  @@index([pasajeroId, creadoEn(sort: Desc)])
  @@map("reservas")
}
